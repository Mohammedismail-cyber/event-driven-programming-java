<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- BorderPane divides the window into Top, Left, Right, Center, Bottom -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.university.MainController">

    <!-- LEFT: navigation sidebar -->
    <left>
        <VBox spacing="10" prefWidth="170" style="-fx-padding: 20; -fx-background-color: #2c3e50;">
            <Button text="Dashboard" onAction="#showDashboard" maxWidth="Infinity"
                    style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Button text="Students" onAction="#showStudents" maxWidth="Infinity"
                    style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
        </VBox>
    </left>

    <!-- CENTER: the active view is loaded here -->
    <center>
        <StackPane fx:id="centerPane" style="-fx-padding: 20;"/>
    </center>
</BorderPane>
